{
  "name": "@zahidhasann/mockline",
  "version": "0.1.0",
  "description": "A local mock API server and TypeScript library powered by OpenAPI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "\u003e=20"
  },
  "packageManager": "pnpm@9.15.9",
  "bin": {
    "mockline": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahidhasann88/mockline.git"
  },
  "bugs": {
    "url": "https://github.com/zahidhasann88/mockline/issues"
  },
  "homepage": "https://github.com/zahidhasann88/mockline#readme",
  "keywords": [
    "openapi",
    "mock-server",
    "api",
    "testing",
    "typescript",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"for (const p of [\u0027dist\u0027, \u0027coverage\u0027]) require(\u0027node:fs\u0027).rmSync(p, { recursive: true, force: true })\"",
    "lint": "eslint src tests scripts *.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsup \u0026\u0026 vitest run --coverage",
    "test:watch": "vitest",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only",
    "benchmark": "tsx scripts/benchmark.ts",
    "pack:check": "tsup \u0026\u0026 node scripts/verify-pack.mjs",
    "demo": "pnpm build \u0026\u0026 node scripts/demo.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cac": "^7.0.0",
    "chokidar": "^5.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.12",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^5.0.3",
    "zod-to-json-schema": "^3.24.5"
  },
  "author": "Zahid Hasan \u003cjahidhasann67@gmail.com\u003e"
}
