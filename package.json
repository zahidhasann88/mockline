{
  "name": "@zahid15/mockline",
  "version": "0.5.0",
  "description": "A local mock API server and TypeScript library powered by OpenAPI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@9.15.9",
  "bin": {
    "mockline": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zahidhasann88/mockline.git"
  },
  "bugs": {
    "url": "https://github.com/zahidhasann88/mockline/issues"
  },
  "homepage": "https://github.com/zahidhasann88/mockline#readme",
  "keywords": [
    "openapi",
    "mock-server",
    "api",
    "testing",
    "typescript",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"for (const p of ['dist', 'coverage']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "eslint src tests scripts *.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsup && vitest run --coverage",
    "test:watch": "vitest",
    "schema:config": "tsx scripts/generate-config-schema.ts",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only",
    "pack:check": "tsup && node scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cac": "^7.1.0",
    "chokidar": "^6.0.0",
    "picocolors": "^1.1.1",
    "swagger2openapi": "^7.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "author": "Zahid Hasan"
}
